def test_hotspot_filter_with_match(monkeypatch, tmp_path):
    monkeypatch.setattr(tform, "HOTSPOT_DIR", str(tmp_path))
    (tmp_path / "tplAB.json").write_text(json.dumps({"A": [["10", "ALA"], ["20", "ALA"]], "B": []}))
